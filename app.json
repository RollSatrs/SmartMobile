{
  "expo": {
    "name": "Smart City Abai",
    "slug": "smart-city-abai",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "smartcityabai",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F4F7F3",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "kz.smartcity.abai",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyCanYJ_-uNmIF9brihDRNJuOm9nRlMHINI"
        }
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Разрешите доступ к фотографиям, чтобы прикрепить снимок к идее.",
          "cameraPermission": "Разрешите доступ к камере, чтобы сфотографировать проблему."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Разрешите определить местоположение, чтобы поставить точку идеи на карте."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "46af7001-235c-433a-b97e-d7bc12e65891"
      }
    }
  }
}
